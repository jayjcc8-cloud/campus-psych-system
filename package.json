{
  "name": "teacher-support-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev:api": "pnpm --filter @teacher-support/api dev",
    "dev:admin": "pnpm --filter @teacher-support/admin-web dev",
    "dev:official": "pnpm --filter @teacher-support/official-web dev",
    "dev:user": "pnpm --filter @teacher-support/user-client dev:mp-weixin",
    "build:official": "pnpm --filter @teacher-support/official-web build",
    "build": "pnpm -r --filter './apps/**' build",
    "check": "pnpm -r check",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "test:api:integration": "pnpm --filter @teacher-support/api test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "prettier": "^3.8.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.59.2",
    "vue-eslint-parser": "^10.4.0"
  }
}
