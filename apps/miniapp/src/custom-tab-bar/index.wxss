.custom-tabbar {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 4px;
  align-items: center;
  width: 100%;
  min-height: calc(68px + env(safe-area-inset-bottom));
  padding: 6px 12px calc(7px + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1px solid rgba(188, 216, 214, 0.7);
  box-shadow: 0 -12px 28px rgba(42, 94, 91, 0.1);
}

.custom-tabbar-teacher {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding-left: 18px;
  padding-right: 18px;
}

.custom-tabbar-item {
  display: flex;
  flex-direction: column;
  gap: 3px;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 54px;
  padding: 5px 4px 4px;
  color: #86a9a8;
  border-radius: 18px;
  overflow: hidden;
}

.custom-tabbar-teacher .custom-tabbar-item {
  min-height: 54px;
  padding-left: 10px;
  padding-right: 10px;
}

.custom-tabbar-item.is-active {
  color: #2e8f8c;
  background: linear-gradient(180deg, #e9f7f5, #f4fbfa);
  box-shadow: inset 0 0 0 1px rgba(91, 192, 190, 0.22), 0 8px 18px rgba(47, 143, 145, 0.08);
}

.custom-tabbar-icon {
  flex-shrink: 0;
  width: 29px;
  height: 29px;
}

.custom-tabbar-label {
  display: block;
  max-width: 100%;
  overflow: hidden;
  font-size: 13px;
  font-weight: 700;
  line-height: 1.15;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
